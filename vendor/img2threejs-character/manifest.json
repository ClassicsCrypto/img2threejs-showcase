{
  "name": "img2threejs-character",
  "displayName": "img2threejs Character Plugin",
  "version": "0.1.0",
  "coreCompatibility": "img2threejs 1.5",
  "primaryRepresentation": "CharacterIR",
  "entry": "./plugin.ts",
  "runtime": "Three.js",
  "architecture": ["independent-ir", "independent-compiler", "independent-runtime", "independent-conformance", "dependency-aware-repair"],
  "coordinateSystem": { "up": "+Y", "front": "+Z", "ground": "Y=0", "characterHeight": 1, "leftSign": 1 },
  "profiles": {
    "lite": { "continuousAnatomy": true, "basicPBR": true, "basicPose": true, "simpleFibers": true, "limitedMorphs": true },
    "standard": { "continuousAnatomy": true, "deformationTopology": true, "skinnedMesh": true, "mikkTangentContract": true, "surfaceAttachment": true, "hairFlow": true, "wearableFit": true, "correctiveMorphs": true, "ik": true },
    "hero": { "advancedFace": true, "sss": "capability-gated", "tsl": "capability-gated", "advancedFibers": true, "advancedWearables": true, "multipleLOD": true, "webgpu": "capability-gated" }
  },
  "pipeline": [
    { "id": "C0_CHARACTER_ADMISSION", "requiredThreeDocs": ["https://threejs.org/docs/"] },
    { "id": "C1_CHARACTER_EVIDENCE", "requiredThreeDocs": ["PerspectiveCamera", "Matrix4"] },
    { "id": "C2_ARCHETYPE_SEMANTIC_GRAPH", "requiredThreeDocs": ["Object3D"] },
    { "id": "C3_LANDMARK_PROPORTION_SOLVE", "requiredThreeDocs": ["Quaternion"] },
    { "id": "C4_SHAPE_RECONSTRUCTION", "requiredThreeDocs": ["LoftGeometry", "Curve", "BufferGeometry"] },
    { "id": "C5_CONTINUOUS_SURFACE_TOPOLOGY", "requiredThreeDocs": ["BufferGeometry", "BufferGeometryUtils"] },
    { "id": "C6_SURFACE_APPEARANCE", "requiredThreeDocs": ["DecalGeometry", "Raycaster", "MeshPhysicalMaterial"] },
    { "id": "C7_RIG_CONSTRUCTION", "requiredThreeDocs": ["Bone", "Skeleton", "SkinnedMesh"] },
    { "id": "C8_FIBER_HAIR_FUR", "requiredThreeDocs": ["MeshSurfaceSampler", "Curve", "TubeGeometry", "MeshPhysicalMaterial"] },
    { "id": "C9_DEFORMATION_WEARABLES_APPENDAGES", "requiredThreeDocs": ["CCDIKSolver", "SkinnedMesh", "TubeGeometry"] },
    { "id": "C10_RUNTIME_COMPILATION", "requiredThreeDocs": ["Object3D", "AnimationMixer"] },
    { "id": "C11_CHARACTER_CONFORMANCE", "requiredThreeDocs": ["BufferGeometry", "Raycaster"] },
    { "id": "C12_DEPENDENCY_AWARE_REPAIR", "requiredThreeDocs": ["Three.js docs"] }
  ],
  "officialReferences": [
    "https://threejs.org/docs/", "https://threejs.org/docs/pages/Object3D.html", "https://threejs.org/docs/pages/BufferGeometry.html", "https://threejs.org/docs/pages/LoftGeometry.html", "https://threejs.org/docs/pages/Curve.html", "https://threejs.org/docs/pages/TubeGeometry.html", "https://threejs.org/docs/pages/DecalGeometry.html", "https://threejs.org/docs/pages/Raycaster.html", "https://threejs.org/docs/pages/MeshSurfaceSampler.html", "https://threejs.org/docs/pages/Bone.html", "https://threejs.org/docs/pages/Skeleton.html", "https://threejs.org/docs/pages/SkinnedMesh.html", "https://threejs.org/docs/pages/CCDIKSolver.html", "https://threejs.org/docs/pages/AnimationClip.html", "https://threejs.org/docs/pages/AnimationMixer.html", "https://threejs.org/docs/pages/MeshPhysicalMaterial.html", "https://threejs.org/docs/pages/TSL.html", "https://threejs.org/docs/pages/LOD.html", "https://threejs.org/docs/pages/InstancedMesh.html", "https://threejs.org/docs/pages/BatchedMesh.html", "https://threejs.org/docs/pages/WebGPURenderer.html", "https://threejs.org/docs/pages/GLTFExporter.html"
  ],
  "nonGoalsInitialRelease": ["full physical cloth simulation", "muscle simulation", "soft-body physics", "real-time strand simulation", "motion capture", "locomotion synthesis", "animation editor"]
}
